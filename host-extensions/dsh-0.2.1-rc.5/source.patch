+  expect(view.container.textContent).not.toContain('untrusted')
+  expect(view.container.querySelector('script')).toBeNull()
+})
+it('rejects malformed optional state without inventing a default', () => {
+  for (const value of [undefined, {}, { state: 'pending', reason: 'guess' }, { state: 'unknown', reason: 'awaiting-data' }])
+    expect(telemetryUnavailable(value)).toBeUndefined()
+  for (const value of [{}, { runId: 'r', sequence: -1, phase: 'requesting' },
+    { runId: 'r', sequence: 1, phase: 'failed', statusCode: 0 },
+    { runId: 'r', sequence: 1, phase: 'failed', retryable: 'yes' }])
