+  expect(view.getByText('CLI 正在请求模型')).toBeTruthy()
+  expect(view.container.querySelector('[data-chat-running]')).toBeTruthy()
+  expect(view.container.querySelector('[data-step-process]')).toBeNull()
+  expect(view.container.textContent).not.toContain('正在分析请求')
