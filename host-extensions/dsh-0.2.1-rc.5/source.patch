+    expect(dialog.textContent).not.toContain('cliworker-native')
+  })
+
+  it('keeps ordinary native Turn accounting unchanged without a matching external source', () => {
+    expect(resolveExternalTurnUsage(4, usage, undefined).usage).toBe(usage)
+    expect(resolveExternalTurnUsage(4, usage, { 5: external }).usage).toBe(usage)
+    const f = fixture(undefined, usage)
+    fireEvent.click(f.view.getByRole('button', { name: /43/ }))
+    expect(f.view.getByRole('dialog').textContent).not.toContain('统计来源')
+  })
+  it('shows the exact run aggregate through the native tail and panel without adding native usage', () => {
+    const f = fixture({ 4: external }, { ...usage, totalTokens: 9999 })
+    fireEvent.click(f.view.getByRole('button', { name: /43/ }))
+    const dialog = f.view.getByRole('dialog')
+    expect(dialog.textContent).toContain('CLI 本轮合计')
+    expect(dialog.textContent).toContain('统计来源')
+    expect(dialog.textContent).not.toContain('提供方 / 模型')
+    expect(dialog.textContent).not.toContain('9,999')
+    expect(dialog.parentElement).toBe(document.body)
+  })
+  it('makes an explicit null authoritative and follows live source updates', () => {
+    const f = fixture({ 4: null }, usage)
+    expect(f.view.queryByRole('button', { name: /43/ })).toBeNull()
+    const trigger = f.view.getByRole('button', { name: '用量未知' })
+    fireEvent.click(trigger)
+    expect(trigger.getAttribute('aria-expanded')).toBe('true')
+    const dialog = f.view.getByRole('dialog', { name: '本轮用量' })
+    expect(dialog.textContent).not.toContain('本轮尚无可核验')
+    expect(dialog.querySelector('p')).toBeNull()
+    expect(dialog.textContent).not.toContain('43')
+    expect(dialog.textContent).not.toContain('0 tok')
+    expect(dialog.parentElement).toBe(document.body)
+    fireEvent.keyDown(document, { key: 'Escape' })
+    expect(f.view.queryByRole('dialog')).toBeNull()
+    f.update({ 4: external })
+    expect(f.view.getByRole('button', { name: /43/ })).toBeTruthy()
+    f.update({ 4: null })
+    expect(f.view.queryByRole('button', { name: /43/ })).toBeNull()
+    expect(f.view.getByRole('button', { name: '用量未知' })).toBeTruthy()
+    f.update(undefined)
+    expect(f.view.getByRole('button', { name: /43/ })).toBeTruthy()
+    expect(f.view.queryByRole('button', { name: '用量未知' })).toBeNull()
+  })
+  it('offers unknown usage only for the exact explicit null, not another turn or a malformed receipt', () => {
+    const f = fixture({ 5: null })
+    expect(f.view.queryByRole('button', { name: '用量未知' })).toBeNull()
+    f.update({ 4: null })
+    expect(f.view.getByRole('button', { name: '用量未知' })).toBeTruthy()
+    f.update({ 4: { ...external, runIds: ['same', 'same'] } })
+    expect(f.view.queryByRole('button', { name: /用量/ })).toBeNull()
+    expect(resolveExternalTurnUsage(4, usage, { 4: null })).toEqual({ usage: undefined, external: true, externalUnknown: true })
+  })
+  it('rejects duplicate runs and never invents totals or missing numeric buckets', () => {
+    const invalid = [
+      { ...external, runIds: ['same', 'same'] },
+      { ...external, runIds: [] },
+      { ...external, usage: { ...usage, totalTokens: undefined } },
+      { ...external, usage: { ...usage, uncachedInputTokens: undefined } },
+      { ...external, usage: { ...usage, outputTokens: -1 } },
+      { ...external, usage: { ...usage, totalTokens: NaN } },
+      { ...external, usage: { ...usage, reasoningTokens: 100 } },
+      { ...external, usage: { ...usage, totalTokens: 999 } },
+    ]
+    for (const record of invalid) expect(resolveExternalTurnUsage(4, usage, { 4: record as ExternalTurnUsage }).usage).toBeUndefined()
+    const minimal = resolveExternalTurnUsage(4, undefined, { 4: { ...external, usage: { uncachedInputTokens: 12, outputTokens: 8, totalTokens: 20 } } })
+    expect(minimal.usage).toEqual({ uncachedInputTokens: 12, outputTokens: 8, totalTokens: 20 })
+  })
+  it('does not copy injected provider routes into external accounting', () => {
+    const record = { ...external, usage: { ...usage, routes: [{ provider: 'PRIVATE_PROVIDER', model: 'PRIVATE_MODEL' }] } }
+    const accepted = resolveExternalTurnUsage(4, undefined, { 4: record })
+    expect(accepted.usage?.routes).toBeUndefined()
+    expect(JSON.stringify(accepted)).not.toContain('PRIVATE')
+  })
+})
