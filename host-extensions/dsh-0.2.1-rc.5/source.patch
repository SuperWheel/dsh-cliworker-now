+    expect(view.queryByText('缓存读取')).toBeNull()
+    expect(view.queryByText('缓存写入')).toBeNull()
+    expect(dialog.textContent).toContain('缓存命中—')
+    expect(dialog.textContent).not.toContain('无法计算命中率')
+    expect(dialog.textContent).not.toContain('未缓存输入')
+    expect(dialog.textContent).not.toContain('43 tok')
+    expect(dialog.parentElement).toBe(document.body)
