+    expect(dialog.textContent).not.toMatch(/Token|tok|43/)
+    f.update({ 4: { basis: 'external-run', runIds: ['synthetic-run'], usageUnit: 'credits' } })
+    expect(dialog.textContent).not.toContain('0.252595')
+    expect(dialog.textContent).toContain('—')
+  })
+  it('keeps exact native counts but replaces the internal route using independent run metadata', () => {
