+    const trigger = view.getByRole('button', { name: '缓存命中 —' })
+    expect(trigger.textContent).toBe('缓存命中 —')
+    fireEvent.click(trigger)
+    const dialog = view.getByRole('dialog')
+    expect(dialog.textContent).toContain('3,901 tok')
+    expect(dialog.textContent).not.toContain('无法计算命中率')
+    expect(dialog.textContent).not.toContain('0%')
+    fireEvent.keyDown(document, { key: 'Escape' })
+    expect(view.queryByRole('dialog')).toBeNull()
+  })
+  it.each([0, 40])('keeps explicitly reported cache %i separate from unknown cache (synthetic)', cached => {
