--- /dev/null
+++ b/packages/client/ui-chat/src/client/chat/ExternalUsageRows.tsx
@@ -0,0 +1,29 @@
+import type { ExternalUsageReport } from '../contract/external-usage.ts'
+import type { ChatViewSlotProps } from '../contract/slots.ts'
+import { formatExactTokens } from './token-format.ts'
+import css from './stat-dialog.module.css'
+
+/** Known external facts in the existing native statistics description list. */
+export function ExternalUsageRows({ usage, t }: { usage: ExternalUsageReport; t: ChatViewSlotProps['t'] }) {
+  const count = (value: number) => t('message.turnUsage.count', { count: formatExactTokens(value, t) })
+  return <>
+    {usage.inputTokens !== undefined && <>
+      <dt>{t(usage.inputBasis === 'reported' ? 'message.turnUsage.reportedInput' : usage.inputBasis === 'inclusive' ? 'message.turnUsage.inclusiveInput' : 'message.turnUsage.input')}</dt>
+      <dd>{count(usage.inputTokens)}</dd>
+    </>}
+    {usage.cacheReadTokens !== undefined && <><dt>{t('message.turnUsage.cacheRead')}</dt><dd>{count(usage.cacheReadTokens)}</dd></>}
+    {usage.cacheWriteTokens !== undefined && <><dt>{t('message.turnUsage.cacheWrite')}</dt><dd>{count(usage.cacheWriteTokens)}</dd></>}
+    {usage.outputTokens !== undefined && <>
+      <dt>{t('message.turnUsage.output')}</dt>
+      <dd>{count(usage.outputTokens)}{usage.reasoningTokens !== undefined && <span className={css.reasoning}>
+        {t('message.turnUsage.reasoning', { tokens: count(usage.reasoningTokens) })}
+      </span>}</dd>
+    </>}
+    {usage.outputTokens === undefined && usage.reasoningTokens !== undefined && <>
+      <dt>{t('message.turnUsage.reasoningOnly')}</dt><dd>{count(usage.reasoningTokens)}</dd>
+    </>}
+    {usage.orchestration?.input !== undefined && <><dt>{t('message.turnUsage.orchestrationInput')}</dt><dd>{count(usage.orchestration.input)}</dd></>}
+    {usage.orchestration?.output !== undefined && <><dt>{t('message.turnUsage.orchestrationOutput')}</dt><dd>{count(usage.orchestration.output)}</dd></>}
+    {usage.orchestration?.cacheRead !== undefined && <><dt>{t('message.turnUsage.orchestrationCacheRead')}</dt><dd>{count(usage.orchestration.cacheRead)}</dd></>}
+  </>
+}
