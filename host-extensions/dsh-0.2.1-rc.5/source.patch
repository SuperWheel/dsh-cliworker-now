+  fireEvent.click(view.getByRole('button', { name: '1 轮 1 步' }))
+  expect(view.getByRole('dialog').textContent).not.toContain('Harness 调用 CLI')
+  expect(view.getByRole('dialog').textContent).not.toContain('CLI 启动和会话准备时间')
