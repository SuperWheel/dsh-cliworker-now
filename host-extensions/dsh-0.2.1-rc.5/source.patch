new file mode 100644
index 0000000000000000000000000000000000000000..faaa0610ff5fa5378df1526f97dfa4c65f6d062b
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/contract/external-status.ts
@@ -0,0 +1,38 @@
+/** Optional Session-generation sources for externally executed requests.
+ * These are presentation facts, never token accounting or synthetic Session events.
+ */
+export interface TelemetryUnavailable {
+  readonly state: 'pending' | 'unavailable'
+  readonly reason: 'awaiting-data' | 'not-reported' | 'disconnected'
+}
+export interface TelemetryAvailability {
+  readonly statisticsBasis?: 'harness-cli-adapter'
+  readonly usageUnit?: 'credits'
+  readonly statistics?: TelemetryUnavailable
+  readonly tokenUsage?: TelemetryUnavailable
+  readonly context?: TelemetryUnavailable
+}
+export interface ExternalRequestState {
+  readonly runId: string
+  readonly sequence: number
+  readonly phase: 'requesting' | 'failed'
+  readonly statusCode?: number
+  /** Producer code only. Views map a finite set and never display raw errors. */
+  readonly reason?: string
+  readonly retryCount?: number
+  readonly retryable?: boolean
+}
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionMap {
+    telemetryAvailability: TelemetryAvailability
+    externalRequestState: ExternalRequestState
+  }
+}
+/** Ignore malformed optional states rather than interpreting absence as zero. */
+export function telemetryUnavailable(value: unknown): TelemetryUnavailable | undefined {
+  if (!value || typeof value !== 'object') return undefined
+  const state = value as Partial<TelemetryUnavailable>
+  return (state.state === 'pending' || state.state === 'unavailable')
+    && (state.reason === 'awaiting-data' || state.reason === 'not-reported' || state.reason === 'disconnected')
+    ? state as TelemetryUnavailable : undefined
+}
