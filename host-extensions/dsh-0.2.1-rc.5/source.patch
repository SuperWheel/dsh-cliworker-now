+    fireEvent.click(view.getByRole('button'))
+    expect(view.getByRole('dialog').textContent).toContain('积分0.28')
+    expect(view.getByRole('dialog', { name: '积分用量' }).textContent).not.toMatch(/token|tok/i)
+  })
+  it('calculates Hermes cache hits from observed inclusive input without inventing cache writes (synthetic)', () => {
+    const report: ExternalUsageReport = { totalTokens: 4089, inputBasis: 'inclusive', inputTokens: 4054, outputTokens: 35, cacheReadTokens: 192 }
+    expect(externalUsageReport(report)).toEqual(report)
+    expect(externalCacheRatio(report)).toEqual({ cached: 192, input: 4054 })
+    const view = stats(report)
+    expect(view.getByRole('button').textContent).toContain('缓存命中 5%')
+    fireEvent.click(view.getByRole('button'))
