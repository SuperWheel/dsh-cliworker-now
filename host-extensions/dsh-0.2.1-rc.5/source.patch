+// @vitest-environment jsdom
+import { afterEach, expect, it } from 'vitest'
+import { cleanup, fireEvent, render } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import { UsagePill } from '../src/client/chat/StatsPills.tsx'
+import { zh } from '../src/client/locale.ts'
+
+afterEach(cleanup)
+const t = makeTranslate(zh, commonZh)
+const buckets = { uncachedInputTokens: 12, outputTokens: 8, cacheReadTokens: 20, cacheWriteTokens: 3 }
+function fixture(metadata: Record<string, unknown>) {
+  const props: any = { t, usePerformanceUsage: (selector: (value: string) => unknown) => selector('detailed'),
+    useChat: (selector: (value: any) => unknown) => selector({ legacy: { nodes: [] } }),
+    useProjection: (key: string) => key === 'tokenUsage' ? { ...buckets, ...metadata } : undefined,
+  }
+  const view = render(<UsagePill {...props} />)
+  fireEvent.click(view.getByRole('button', { name: /43/ }))
+  return view.getByRole('dialog')
+}
+
+it.each([
+  [{ externalScope: 'run', externalRunId: 'synthetic-run' }, '本轮运行'],
+  [{ externalScope: 'run', externalRunId: 'synthetic-run', externalIsPrevious: true }, '最近已确认运行'],
+  [{ externalScope: 'reported', externalRunId: 'synthetic-run' }, '已公开响应统计'],
+] as const)('keeps native counters and displays only the actual external accounting source %j', (metadata, expected) => {
+  const dialog = fixture(metadata)
+  expect(dialog.textContent).toContain(expected)
+  expect(dialog.textContent).toContain('统计来源')
+  expect(dialog.textContent).toContain('43 tok')
+  expect(dialog.textContent).toContain('12 tok')
+  expect(dialog.textContent).toContain('20 tok')
+  expect(dialog.textContent).toContain('3 tok')
+  expect(dialog.textContent).toContain('8 tok')
+  expect(dialog.textContent).not.toContain('synthetic-run')
+  expect(dialog.parentElement).toBe(document.body)
