+})
+
+it('keeps an explicitly supplied real zero receipt distinct from missing data', () => {
+  const view = stats({ telemetryAvailability: { tokenUsage: pending }, tokenUsage: {
+    uncachedInputTokens: 0, cacheReadTokens: 0, cacheWriteTokens: 0, outputTokens: 0 } })
