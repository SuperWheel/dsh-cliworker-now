diff --git a/packages/client/ui-chat/src/client/contract/external-status.ts b/packages/client/ui-chat/src/client/contract/external-status.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a8cadb9bc0b0e9ba140b254b537e6440149ffb88
--- /dev/null
+++ b/packages/client/ui-chat/src/client/contract/external-status.ts
@@ -0,0 +1,28 @@
+/** Local validation of optional external wire snapshots.
+ * Conversation owns the public types. Chat has no runtime dependency on that
+ * plugin entry: each consumer validates the presentation facts it displays.
+ */
+import type { ExternalRequestState, TelemetryUnavailable } from '@deepseek-ai/dsh-client-ui-conversation/client'
+
+/** Ignore malformed optional states rather than interpreting absence as zero. */
+export function telemetryUnavailable(value: unknown): TelemetryUnavailable | undefined {
+  if (!value || typeof value !== 'object') return undefined
+  const state = value as Partial<TelemetryUnavailable>
+  return (state.state === 'pending' || state.state === 'unavailable')
+    && (state.reason === 'awaiting-data' || state.reason === 'not-reported' || state.reason === 'disconnected')
+    ? state as TelemetryUnavailable : undefined
+}
+
+/** Validate a current source snapshot; binding/run ordering belongs to its provider. */
+export function externalRequestState(value: unknown): ExternalRequestState | undefined {
+  if (!value || typeof value !== 'object') return undefined
+  const state = value as Partial<ExternalRequestState>
+  if (typeof state.runId !== 'string' || state.runId.length === 0 || state.runId.length > 512
+    || !Number.isSafeInteger(state.sequence) || state.sequence! < 0
+    || (state.phase !== 'requesting' && state.phase !== 'failed')
+    || (state.statusCode !== undefined && (!Number.isInteger(state.statusCode) || state.statusCode < 100 || state.statusCode > 599))
+    || (state.reason !== undefined && (typeof state.reason !== 'string' || state.reason.length > 128))
+    || (state.retryCount !== undefined && (!Number.isSafeInteger(state.retryCount) || state.retryCount < 0))
+    || (state.retryable !== undefined && typeof state.retryable !== 'boolean')) return undefined
+  return state as ExternalRequestState
+}
diff --git a/packages/client/ui-chat/src/client/contract/external-turn-answer.ts b/packages/client/ui-chat/src/client/contract/external-turn-answer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9673e2681db9024c666e95d5de34e61664f00487
--- /dev/null
+++ b/packages/client/ui-chat/src/client/contract/external-turn-answer.ts
@@ -0,0 +1,173 @@
+import type { GroupKey, NodeReference, RenderEntry } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { ChatNode, FinalAssistantChatData } from './chat-nodes.ts'
+import type { ChatSnapshot, ChatTurnProcessPresentation } from './snapshot.ts'
+import type { TurnProcessSpec } from './turn-process.ts'
+import { isAtOrOutside } from './group-tree.ts'
+import { isVisibleChatNode } from './chat-visibility.ts'
+
+/** Identity of an existing answer in one proven completed external Turn.
+ * The Host owns run/origin/parent verification. This never supplies new content.
+ */
+export interface ExternalTurnAnswer {
+  readonly answerSeq: number
+  readonly answerStep: number
+  readonly messageId: string
+  readonly turnEndSeq: number
+}
+export type ExternalTurnAnswerProjection = Readonly<Record<string, ExternalTurnAnswer>>
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionMap {
+    externalTurnAnswer: ExternalTurnAnswerProjection
+  }
+}
+export interface ResolvedExternalTurnAnswer {
+  readonly answerNodeKey: string
+  readonly answer: Readonly<FinalAssistantChatData>
+  readonly spec: TurnProcessSpec
+  readonly hasExternalProcess: boolean
+}
+const count = (value: unknown): value is number => Number.isSafeInteger(value) && (value as number) >= 0
+function anchor(value: unknown): ExternalTurnAnswer | undefined {
+  if (!value || typeof value !== 'object') return undefined
+  const x = value as Partial<ExternalTurnAnswer>
+  return count(x.answerSeq) && count(x.answerStep) && count(x.turnEndSeq) && x.answerSeq < x.turnEndSeq
+    && typeof x.messageId === 'string' && x.messageId.length > 0 && x.messageId.length <= 512
+    ? x as ExternalTurnAnswer : undefined
+}
+function turnOf(node: ChatNode): number | undefined {
+  const location = node.location
+  return location.kind === 'turn' || location.kind === 'step' ? location.turn.turn : undefined
+}
+function continuation(node: ChatNode): boolean {
+  if (node.kind !== 'user' && node.kind !== 'steering' && node.kind !== 'context' && node.kind !== 'turn-trigger') return false
+  const source = node.data.source as { kind?: unknown } | null
+  return source?.kind === 'cliworker-continuation' && node.data.content.length === 0
+}
+function onlyReasoningOrEmpty(data: Readonly<FinalAssistantChatData>['blocks']): boolean {
+  return data.every(block => block.kind === 'reasoning' || (block.kind === 'text' && block.text.trim() === ''))
+}
+
+/** Resolve presentation metadata against the loaded, unchanged native snapshot.
+ * Missing pages, changed boundaries, later input/tools/replies, and conflicts
+ * retain the default native policy. No Session event or Node is modified.
+ */
+export function resolveExternalTurnAnswer(
+  snapshot: ChatSnapshot, turnNumber: number, supplied: unknown,
+): ResolvedExternalTurnAnswer | undefined {
+  const proof = anchor(supplied)
+  const turn = snapshot.timeline.turns.get(turnNumber)
+  if (!proof || turn?.status !== 'closed' || turn.start === undefined || turn.end?.seq !== proof.turnEndSeq
+    || turn.end.data.reason.kind !== 'completed' || proof.answerSeq <= turn.start.seq) return undefined
+  const nodes = snapshot.nodes.values().filter(node => turnOf(node as ChatNode) === turnNumber) as readonly ChatNode[]
+  const candidates = nodes.filter((node): node is ChatNode<'assistant-step'> => node.kind === 'assistant-step'
+    && node.data.step === proof.answerStep && node.data.finalNode?.seq === proof.answerSeq
+    && node.data.finalNode.messageId === proof.messageId)
+  const candidate = candidates[0]
+  if (candidates.length !== 1 || candidate === undefined || candidate.visibility !== 'visible'
+    || candidate.data.status !== 'settled' || candidate.data.turn !== turnNumber
+    || candidate.data.finalNode?.turn !== turnNumber || candidate.data.finalNode.step !== proof.answerStep
+    || !candidate.data.blocks.some(block => block.kind === 'text' && block.text.trim() !== '')
+    || candidate.data.blocks.some(block => block.kind !== 'text' && block.kind !== 'reasoning')) return undefined
+  const actualStep = turn.steps.find(step => step.step === proof.answerStep)
+  if (actualStep?.status !== 'closed' || actualStep.start === undefined || actualStep.end === undefined
+    || actualStep.start.seq >= proof.answerSeq || actualStep.end.seq <= proof.answerSeq || actualStep.end.seq >= proof.turnEndSeq
+    || actualStep.data.get('assistant-step')?.finalNode?.seq !== proof.answerSeq
+    || actualStep.data.get('assistant-step')?.finalNode?.messageId !== proof.messageId) return undefined
+  for (const step of turn.steps) {
+    if (step.step <= proof.answerStep) continue
+    const data = step.data.get('assistant-step')
+    if (step.status !== 'closed' || step.end === undefined
+      || (data !== undefined && (data.status !== 'settled' || !onlyReasoningOrEmpty(data.blocks)))) return undefined
+  }
+  for (const node of nodes) {
+    if (node === candidate || node.kind === 'turn-process' || node.kind === 'turn-tail') continue
+    const finalSeq = node.kind === 'assistant-step' ? node.data.finalNode?.seq : undefined
+    if (Math.max(node.anchorSeq, finalSeq ?? node.anchorSeq) <= proof.answerSeq) continue
+    if (node.kind === 'assistant-step') {
+      if (node.data.step <= proof.answerStep || node.data.status !== 'settled' || !onlyReasoningOrEmpty(node.data.blocks)) return undefined
+    } else if (!continuation(node)) return undefined
+  }
+  const base = turn.data.get('turn-process')
+  if (base === undefined) return undefined
+  const spec: TurnProcessSpec = {
+    ...base,
+    processStartSeq: turn.start.seq,
+    // The validated durable seq identifies the message; its native live anchor
+    // is the visual boundary and may precede that settlement seq.
+    answerAnchorSeq: candidate.anchorSeq,
+    answerStep: proof.answerStep,
+    inlineReasoning: candidate.data.blocks.some(block => block.kind === 'reasoning' && block.text.trim() !== ''),
+    messageCount: base.answerStep === proof.answerStep ? base.messageCount : Math.max(0, base.messageCount - 1),
+  }
+  const hasExternalProcess = nodes.some(node => node !== candidate && isVisibleChatNode(node)
+    && !isAtOrOutside(node, 'turn')
+    && (node.kind !== 'assistant-step' || node.data.blocks.some(block => block.kind !== 'text' || block.text.trim() !== '')))
+  return { answerNodeKey: candidate.key, answer: candidate.data as FinalAssistantChatData, spec, hasExternalProcess }
+}
+
+/** Canonical Turn keys prevent aliases and never affect other/new Turns. */
+export function resolveExternalTurnAnswers(snapshot: ChatSnapshot | undefined, supplied: unknown): ReadonlyMap<number, ResolvedExternalTurnAnswer> {
+  const result = new Map<number, ResolvedExternalTurnAnswer>()
+  if (!snapshot || !supplied || typeof supplied !== 'object' || Array.isArray(supplied)) return result
+  for (const [key, proof] of Object.entries(supplied)) {
+    const turn = Number(key)
+    if (!count(turn) || turn === 0 || String(turn) !== key) continue
+    const resolved = resolveExternalTurnAnswer(snapshot, turn, proof)
+    if (resolved !== undefined) result.set(turn, resolved)
+  }
+  return result
+}
+/** Share one effective process state across native seats, groups and header. */
+export function externalTurnProcessPresentation(
+  native: ChatTurnProcessPresentation | undefined,
+  resolved: ReadonlyMap<number, ResolvedExternalTurnAnswer>,
+): ChatTurnProcessPresentation | undefined {
+  const answer = native === undefined ? undefined : resolved.get(native.turn)
+  return native === undefined || answer === undefined ? native
+    : { ...native, spec: answer.spec, hasExternalProcess: answer.hasExternalProcess }
+}
+
+/** Stable native entry ordering for a proven historical external answer.
+ * Move existing process references, never content or DOM/CSS. Default DSH and
+ * unverified entries retain their original sequence and reference identity.
+ */
+export function externalTurnAnswerEntries(
+  entries: readonly RenderEntry[], snapshot: ChatSnapshot | undefined,
+  resolved: ReadonlyMap<number, ResolvedExternalTurnAnswer>,
+  membersOf: (key: GroupKey) => readonly NodeReference[] | undefined = () => undefined,
+): readonly RenderEntry[] {
+  if (snapshot === undefined || resolved.size === 0) return entries
+  let ordered = entries
+  for (const [turn, proof] of resolved) {
+    const answers = ordered.filter((entry): entry is NodeReference => entry.kind === 'node'
+      && entry.key === proof.answerNodeKey && entry.groupPart !== 'reasoning')
+    let answer = answers[0]
+    if (answers.length !== 1 || answer === undefined) continue
+    // Without a grouping contribution, use the native Assistant's two existing
+    // presentation parts so same-node late reasoning still precedes its text.
+    if (answer.groupPart === undefined && proof.spec.inlineReasoning) {
+      const index = ordered.indexOf(answer)
+      const response = { ...answer, groupPart: 'response' }
+      ordered = [...ordered.slice(0, index), { ...answer, groupPart: 'reasoning' }, response, ...ordered.slice(index + 1)]
+      answer = response
+    }
+    const reasoning = (reference: NodeReference): boolean => {
+      const node = snapshot.nodes.get(reference.key) as ChatNode | undefined
+      if (node?.kind !== 'assistant-step' || turnOf(node) !== turn || reference.groupPart === 'response') return false
+      if (!node.data.blocks.some(block => block.kind === 'reasoning' && block.text.trim() !== '')) return false
+      return reference.groupPart === 'reasoning' || onlyReasoningOrEmpty(node.data.blocks)
+    }
+    const answerIndex = ordered.indexOf(answer)
+    const moved = ordered.slice(answerIndex + 1).filter(entry => {
+      if (entry.kind === 'node') return reasoning(entry)
+      const members = membersOf(entry.key)
+      return members !== undefined && members.length > 0 && members.every(reasoning)
+    })
+    if (moved.length === 0) continue
+    const moving = new Set(moved)
+    const remaining = ordered.filter(entry => !moving.has(entry))
+    const index = remaining.indexOf(answer)
+    ordered = [...remaining.slice(0, index), ...moved, ...remaining.slice(index)]
+  }
+  return ordered
+}
diff --git a/packages/client/ui-chat/src/client/contract/external-turn-usage.ts b/packages/client/ui-chat/src/client/contract/external-turn-usage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8c19ad314dd930ad904a15f1c031215f71260e45
--- /dev/null
+++ b/packages/client/ui-chat/src/client/contract/external-turn-usage.ts
@@ -0,0 +1,88 @@
+import type { TurnTokenUsage } from './chat-nodes.ts'
+import { externalUsageReport, type ExternalUsageReport } from './external-usage.ts'
+
+/** Exact billing buckets from complete external executions bound to one Turn.
+ * This is not a model-response or request-attempt record and has no provider route.
+ */
+interface ExternalTurnUsageIdentity {
+  readonly basis: 'external-run'
+  readonly runIds: readonly string[]
+  /** Public accounting source, independent of model-provider attribution. */
+  readonly label?: string
+  readonly displayRoutes?: readonly string[]
+}
+export type ExternalTurnUsage = ExternalTurnUsageIdentity & (
+  { readonly usage: Omit<TurnTokenUsage, 'routes'>; readonly externalUsage?: never }
+  | { readonly usage?: never; readonly externalUsage: ExternalUsageReport }
+  | { readonly usage?: never; readonly externalUsage?: never; readonly usageUnit: 'credits'; readonly credits?: number }
+  | { readonly usage?: never; readonly externalUsage?: never; readonly nativeUsage: true }
+)
+
+/** Missing keys retain normal native accounting; null explicitly means unknown. */
+export type ExternalTurnUsageProjection = Readonly<Record<string, ExternalTurnUsage | null>>
+
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionMap {
+    /** Optional externally executed, exact Turn aggregates. Never changes Session events. */
+    externalTurnUsage: ExternalTurnUsageProjection
+  }
+}
+
+const count = (value: unknown): value is number => Number.isSafeInteger(value) && (value as number) >= 0
+
+/** Resolve one authoritative source without combining native attempts and external totals. */
+export function resolveExternalTurnUsage(
+  turn: number,
+  native: TurnTokenUsage | undefined,
+  projection: ExternalTurnUsageProjection | undefined,
+): { usage: TurnTokenUsage | undefined; externalUsage?: ExternalUsageReport; label?: string; external?: true; externalUnknown?: true;
+  usageUnit?: 'credits'; credits?: number; displayRoutes?: readonly string[] } {
+  if (projection === undefined || !Object.hasOwn(projection, String(turn))) return { usage: native }
+  const supplied = projection[String(turn)]
+  // Only an exact, explicit null is a bound unknown bill. Missing keys still
+  // retain native accounting; malformed external receipts remain rejected.
+  if (supplied === null) return { usage: undefined, external: true, externalUnknown: true }
+  if (supplied === undefined || supplied.basis !== 'external-run' ||
+    !Array.isArray(supplied.runIds) || supplied.runIds.length === 0 ||
+    supplied.runIds.some(id => typeof id !== 'string' || id.length === 0 || id.length > 512) ||
+    new Set(supplied.runIds).size !== supplied.runIds.length) return { usage: undefined }
+  const displayRoutes = Array.isArray(supplied.displayRoutes) && supplied.displayRoutes.length > 0 && supplied.displayRoutes.length <= 64 &&
+    supplied.displayRoutes.every(route => typeof route === 'string' && route.length > 0 && route.length <= 1200 &&
+      !/[\x00-\x1f\x7f]/.test(route) && !route.startsWith('cliworker-native/')) ? { displayRoutes: supplied.displayRoutes } : {}
+  const hasUsage = Object.hasOwn(supplied, 'usage'), hasReport = Object.hasOwn(supplied, 'externalUsage')
+  if ('usageUnit' in supplied && supplied.usageUnit === 'credits') {
+    if (hasUsage || hasReport || ('nativeUsage' in supplied) || (supplied.credits !== undefined &&
+      (typeof supplied.credits !== 'number' || !Number.isFinite(supplied.credits) || supplied.credits < 0))) return { usage: undefined }
+    return { usage: undefined, external: true, usageUnit: 'credits', ...displayRoutes,
+      ...(supplied.credits === undefined ? {} : { credits: supplied.credits }) }
+  }
+  if ('nativeUsage' in supplied && supplied.nativeUsage === true) {
+    return hasUsage || hasReport || !displayRoutes.displayRoutes ? { usage: undefined } : { usage: native, ...displayRoutes }
+  }
+  if (hasUsage === hasReport) return { usage: undefined }
+  const label = typeof supplied.label === 'string' && supplied.label.length > 0 && supplied.label.length <= 120
+    ? { label: supplied.label } : {}
+  if (hasReport) {
+    const report = externalUsageReport(supplied.externalUsage)
+    return report === undefined ? { usage: undefined } : { usage: undefined, external: true, externalUsage: report, ...label, ...displayRoutes }
+  }
+  const usage = supplied.usage
+  if (!usage || !count(usage.uncachedInputTokens) || !count(usage.outputTokens) || !count(usage.totalTokens))
+    return { usage: undefined }
+  for (const field of ['cacheReadTokens', 'cacheWriteTokens', 'reasoningTokens'] as const) {
+    if (usage[field] !== undefined && !count(usage[field])) return { usage: undefined }
+  }
+  const known = usage.uncachedInputTokens + usage.outputTokens + (usage.cacheReadTokens ?? 0) + (usage.cacheWriteTokens ?? 0)
+  if (!count(known) || usage.totalTokens < known ||
+    (usage.cacheReadTokens !== undefined && usage.cacheWriteTokens !== undefined && usage.totalTokens !== known) ||
+    (usage.reasoningTokens !== undefined && usage.reasoningTokens > usage.outputTokens)) return { usage: undefined }
+  // Do not accept a structurally extra `routes` value as provider attribution.
+  return { external: true, usage: {
+    uncachedInputTokens: usage.uncachedInputTokens,
+    outputTokens: usage.outputTokens,
+    totalTokens: usage.totalTokens,
+    ...(usage.cacheReadTokens === undefined ? {} : { cacheReadTokens: usage.cacheReadTokens }),
+    ...(usage.cacheWriteTokens === undefined ? {} : { cacheWriteTokens: usage.cacheWriteTokens }),
+    ...(usage.reasoningTokens === undefined ? {} : { reasoningTokens: usage.reasoningTokens }),
+  }, ...label, ...displayRoutes }
+}
diff --git a/packages/client/ui-chat/src/client/contract/external-usage.ts b/packages/client/ui-chat/src/client/contract/external-usage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cd87f7bdf2f1da8485552bb413d609b9c06d6a5f
--- /dev/null
+++ b/packages/client/ui-chat/src/client/contract/external-usage.ts
@@ -0,0 +1,71 @@
+/** Exact external bill with optional detail. Unknown categories are absent. */
+export interface ExternalUsageReport {
+  readonly totalTokens: number
+  readonly inputBasis: 'inclusive' | 'uncached' | 'reported'
+  readonly inputTokens?: number
+  readonly outputTokens?: number
+  readonly cacheReadTokens?: number
+  readonly cacheWriteTokens?: number
+  readonly reasoningTokens?: number
+  /** Additional disjoint buckets already included in totalTokens. */
+  readonly orchestration?: { readonly input?: number; readonly output?: number; readonly cacheRead?: number }
+}
+
+const object = (value: unknown): value is Record<string, unknown> => value !== null && typeof value === 'object' && !Array.isArray(value)
+const count = (value: unknown): value is number => typeof value === 'number' && Number.isSafeInteger(value) && value >= 0
+
+/** Validate known facts without completing a partial bill or reducing its total. */
+export function externalUsageReport(value: unknown): ExternalUsageReport | undefined {
+  if (!object(value) || !count(value.totalTokens) || !['inclusive', 'uncached', 'reported'].includes(value.inputBasis as string)) return
+  if (value.inputBasis === 'reported' && (value.cacheReadTokens !== undefined || value.cacheWriteTokens !== undefined)) return
+  const result: { totalTokens: number; inputBasis: 'inclusive' | 'uncached' | 'reported'; inputTokens?: number; outputTokens?: number;
+    cacheReadTokens?: number; cacheWriteTokens?: number; reasoningTokens?: number;
+    orchestration?: { input?: number; output?: number; cacheRead?: number } } = {
+    totalTokens: value.totalTokens, inputBasis: value.inputBasis as ExternalUsageReport['inputBasis'],
+  }
+  for (const key of ['inputTokens', 'outputTokens', 'cacheReadTokens', 'cacheWriteTokens', 'reasoningTokens'] as const) {
+    if (value[key] !== undefined) {
+      if (!count(value[key])) return
+      result[key] = value[key]
+    }
+  }
+  let extras = 0
+  if (value.orchestration !== undefined) {
+    if (!object(value.orchestration)) return
+    const details: { input?: number; output?: number; cacheRead?: number } = {}
+    for (const key of ['input', 'output', 'cacheRead'] as const) {
+      const numeric = value.orchestration[key]
+      if (numeric !== undefined) {
+        if (!count(numeric)) return
+        details[key] = numeric
+        extras += numeric
+      }
+    }
+    result.orchestration = details
+  }
+  const caches = (result.cacheReadTokens ?? 0) + (result.cacheWriteTokens ?? 0)
+  if (result.inputBasis === 'inclusive' && result.inputTokens !== undefined && caches > result.inputTokens) return
+  if (result.reasoningTokens !== undefined && result.outputTokens !== undefined && result.reasoningTokens > result.outputTokens) return
+  const promptLower = result.inputBasis === 'inclusive' ? result.inputTokens ?? caches : (result.inputTokens ?? 0) + caches
+  const lower = promptLower + (result.outputTokens ?? result.reasoningTokens ?? 0) + extras
+  if (!count(lower) || lower > result.totalTokens) return
+  return result
+}
+
+/** Inclusive input is already the denominator; uncached input needs both cache categories. */
+export function externalCacheRatio(usage: ExternalUsageReport): { cached: number; input: number } | undefined {
+  if (usage.inputBasis === 'reported') return
+  if (usage.inputTokens === undefined || usage.cacheReadTokens === undefined) return
+  let input = usage.inputTokens
+  if (usage.inputBasis === 'uncached') {
+    if (usage.cacheWriteTokens === undefined) return
+    input += usage.cacheReadTokens + usage.cacheWriteTokens
+  }
+  let cached = usage.cacheReadTokens
+  if (usage.orchestration !== undefined) {
+    if (usage.orchestration.input === undefined || usage.orchestration.cacheRead === undefined) return
+    input += usage.orchestration.input + usage.orchestration.cacheRead
+    cached += usage.orchestration.cacheRead
+  }
+  return count(input) && count(cached) && cached <= input ? { cached, input } : undefined
+}
