+it('replaces an observed failure on the next real request and hides raw upstream text', () => {
+  const view = render(<RunningStatus startTime={undefined} t={t}
+    request={{ runId: 'synthetic-run', sequence: 2, phase: 'failed', statusCode: 429, reason: 'secret-provider-text' }} />)
+  expect(view.getByText('CLI 模型请求失败')).toBeTruthy()
