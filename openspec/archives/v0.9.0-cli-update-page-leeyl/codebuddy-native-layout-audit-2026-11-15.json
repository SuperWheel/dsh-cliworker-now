      "versions": "<data>/versions/<semver>/codebuddy",
      "entry": "<data>/../../bin/codebuddy"
    },
    "windows": {
      "root": "${LOCALAPPDATA:-~/AppData/Local}/codebuddy",
      "versions": "<root>/Data/versions/<semver>/codebuddy.exe",
      "entry": "<root>/bin/codebuddy.exe"
    },
    "initialEntry": "symlink -> hardlink -> copy fallback (linkOrCopyFile)",
    "updateArgv": [
      "<selected entry>",
      "update"
    ],
    "updateBehavior": "downloadAndExtract into versiondir/<version>, replaceCurrentNativeBinary copies into a temporary sibling of realpath(invoked), then renames; Windows first renames previous binary to .old and rolls back on failure; update need not change version directory name",
    "cleanup": "official pruneOldVersions retains five newest versions and executing version; plugin does not add native residue cleanup"
  },
  "readonlyMachines": {
